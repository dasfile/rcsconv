// Manifest (RT_MANIFEST = 24) and version information (VS_VERSION_INFO).
// Compiled by windres into app_res.o and linked into rcsconv-gui.exe (see build.rs).
// The version comes from version.h, which build.rs generates from Cargo.toml.

#include "version.h"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION RC_VERSION_MAJOR,RC_VERSION_MINOR,RC_VERSION_PATCH,0
PRODUCTVERSION RC_VERSION_MAJOR,RC_VERSION_MINOR,RC_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "rcsconv GUI - .las/.laz/.pts to ReCap .rcs"
            VALUE "FileVersion", RC_VERSION_STRING
            VALUE "InternalName", "rcsconv-gui"
            VALUE "OriginalFilename", "rcsconv-gui.exe"
            VALUE "ProductName", "rcsconv"
            VALUE "ProductVersion", RC_VERSION_STRING
            VALUE "LegalCopyright", "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
