// Манифест (RT_MANIFEST = 24) и сведения о версии (VS_VERSION_INFO).
// Компилируется windres в app_res.o и линкуется в rcsconv-gui.exe (см. build.rs).

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "rcsconv GUI - .las/.laz/.pts to ReCap .rcs"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "rcsconv-gui"
            VALUE "OriginalFilename", "rcsconv-gui.exe"
            VALUE "ProductName", "rcsconv"
            VALUE "ProductVersion", "0.1.0.0"
            VALUE "LegalCopyright", "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
